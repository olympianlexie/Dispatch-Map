# Copy this file to .env for local `netlify dev` testing.
# Never commit the real .env file.

# --- Cartrack Fleet API (Fleetweb PH) ---
# Base URL is region-specific; confirm with Cartrack support / your account docs.
CARTRACK_BASE_URL=https://fleetweb-ph.cartrack.com
CARTRACK_USERNAME=
CARTRACK_PASSWORD=

# --- Google Sheets (service account) ---
# Share the JO monitoring sheet with this service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON, keeping \n escapes as literal characters.
GOOGLE_SERVICE_ACCOUNT_KEY=
SHEET_ID=1u-0jRbyDrglML0hYh-AAVdFHCJrAiP1tLyw_k8VNdik

# --- Nominatim geocoding ---
# Required by Nominatim's usage policy so requests identify the app + a contact.
NOMINATIM_USER_AGENT=olympian-dispatch-map (lexie.matanguihan@olympianict.com)
